<FilesMatch ".(eot|ttf|otf|woff)">
	Header set Access-Control-Allow-Origin "*"
</FilesMatch>

RewriteEngine On 
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://www.dimensionstudio.gr/$1 [R,L]

RewriteEngine On
RewriteCond %{HTTP_HOST} ^dimensionstudio.gr [NC]
RewriteRule ^(.*)$ http://www.dimensionstudio.gr/$1 [L,R=301]

RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9-\s]+)$ index.html [NC,NE,N]
RewriteRule ^([A-Za-z0-9-\s]+)/$ index.html [NC,NE,N]
RewriteRule ^([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)$ index.html [NC,NE,N]
RewriteRule ^([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)/$ index.html [NC,NE]
RewriteRule ^([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)$ index.html [NC,NE,N]
RewriteRule ^([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)/$ index.html [NC,NE]
RewriteRule ^([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)$ index.html [NC,NE,N]
RewriteRule ^([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)/([A-Za-z0-9-\s]+)/$ index.html [NC,NE,L]