<FilesMatch "\.(eot|ttf|otf|woff2?)$">
Header set Access-Control-Allow-Origin "*"
</FilesMatch>

ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# Single permanent redirect to https://www. (a 301 passes search ranking to the final URL)
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^dimensionstudio\.gr$ [NC]
RewriteRule ^(.*)$ https://www.dimensionstudio.gr/$1 [R=301,L]

# Pages are prerendered as <path>/index.html; serve them without a trailing-slash redirect.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]